# Base64-encoded JSON array of valid users (password hashed with bcrypt cost 10)
# WHY base64: bcrypt hashes contain $ signs that dotenv-expand corrupts
#
# Step 1 — generate hash:
#   node -e "require('./node_modules/.pnpm/bcryptjs@3.0.3/node_modules/bcryptjs/index.js').hash('yourpassword', 10).then(h => console.log(h))"
#
# Step 2 — build JSON + base64:
#   node -e "const h='PASTE_HASH_HERE'; console.log(Buffer.from(JSON.stringify([{username:'admin',passwordHash:h}])).toString('base64'))"
VALID_USERS_B64=

# Random secret for JWT signing — min 32 chars
JWT_SECRET=change-this-to-a-random-secret-min-32-chars

# Optional: override per-3PL base URL per environment
# JNE_API_BASE_URL=https://api.jne.co.id
# SICEPAT_API_BASE_URL=https://api.sicepat.com
